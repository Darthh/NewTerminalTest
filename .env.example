# The local preview needs no credentials. Copy to .env.local only when needed.
APP_ORIGIN=http://127.0.0.1:3000
LUNA_ANONYMOUS_HOURLY_LIMIT=15

# Optional web deployment inputs; no AWS resources are created by npm run dev.
AWS_REGION=us-east-1
LUNA_APP_NAME=luna-terminal
LUNA_DOMAIN=

# Reserved architecture switches. Account/research adapters are not implemented.
# Enabling this switch makes the preview SST configuration fail explicitly.
LUNA_DATA=false
# Configure AWS credentials through your own named profile/SSO, never here.
